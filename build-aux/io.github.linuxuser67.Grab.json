{
  "app-id": "io.github.linuxuser67.Grab",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "grab",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.gtk.vfs.*",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-download"
  ],
  "modules": [
    {
      "name": "grab",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "build-options": {
        "env": {
          "CARGO_NET_OFFLINE": "true",
          "CFLAGS": "-O3 -march=x86-64-v2 -flto",
          "CXXFLAGS": "-O3 -march=x86-64-v2 -flto",
          "RUSTFLAGS": "-C target-cpu=x86-64-v2"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": ".."
        },
        "cargo-sources.json",
        {
          "type": "shell",
          "commands": [
            "mkdir -p .cargo",
            "cp -vf cargo/config .cargo/config.toml"
          ]
        }
      ]
    }
  ]
}
