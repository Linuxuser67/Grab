<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.linuxuser67.Grab</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Grab</name>
  <summary>Download manager for GNOME</summary>
  <description>
    <p>
      Queue, pause, resume and monitor file and torrent downloads with smart
      auto-resume, segmented transfers, and per-file torrent picking,
      all in a native GNOME interface.
    </p>
    <p>
      Filter and search the queue, retry failures in bulk, and keep
      everything organized with a download history that survives restarts.
    </p>
    <p>
      Paste a video link to fetch it in up to 4K quality or as audio-only,
      with the title and quality picked before you add it to the queue.
    </p>
  </description>
  <launchable type="desktop-id">io.github.linuxuser67.Grab.desktop</launchable>
  <developer id="io.github.linuxuser67">
    <name>Grab Contributors</name>
  </developer>
  <url type="homepage">https://github.com/Linuxuser67/Grab</url>
  <url type="bugtracker">https://github.com/Linuxuser67/Grab/issues</url>
  <categories>
    <category>Network</category>
    <category>Utility</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <screenshots>
